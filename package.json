{
  "name": "zxftittmtaskc01",
  "version": "0.0.1",
  "description": "ZPR UI5 IT Task Manager Core Library",
  "private": true,
  "devDependencies": {
    "@ui5/cli": "^4.0.33",
    "@sap/ux-ui5-tooling": "1",
    "@sap-ux/eslint-plugin-fiori-tools": "^10.0.0",
    "eslint": "^10",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "fiori run --open \"/sap/bc/ui2/flp?sap-client=100&sap-language=DE#XFTTaskManager-display?recSpsId=ZPR_IT_UI5_SPS_TASK&rmsId=ZXFT_ROOT\"",
    "build": "ui5 build --config=ui5.yaml --clean-dest --dest build_tmp",
    "lint": "eslint ./",
    "deploy": "powershell -ExecutionPolicy Bypass -File deploy-lib.ps1"
  }
}